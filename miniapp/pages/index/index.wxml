<view class="page">

  <!-- 品牌 -->
  <view class="brand">
    <text class="brand-title">DormMate</text>
    <text class="brand-sub">移动控制中心</text>
  </view>

  <!-- 连接状态 -->
  <view class="conn {{connected ? 'conn-ok' : 'conn-bad'}}">{{connText}}</view>

  <!-- 当前重点宿舍 / 优先关注 -->
  <view class="hero {{hero.hasAnomaly ? 'hero-alert' : ''}}">
    <view class="hero-head">
      <text class="hero-label">{{hero.isFocus ? '★ 当前重点宿舍' : '当前优先关注'}}</text>
      <text class="hero-node-id">{{hero.id}}</text>
    </view>
    <view class="hero-name">{{hero.label}}</view>

    <view class="hero-tags">
      <text class="tag {{hero.statusClass}}">{{hero.status}}</text>
      <text class="tag {{hero.phaseClass}}">{{hero.phaseLabel}}</text>
      <text class="tag tag-offline" wx:if="{{hero.offline}}">节点离线</text>
    </view>

    <view class="hero-metrics">
      <view class="hero-metric">
        <text class="hm-k">温度</text>
        <text class="hm-v">{{hero.temperature}}</text>
        <text class="hm-u">℃</text>
      </view>
      <view class="hero-metric">
        <text class="hm-k">湿度</text>
        <text class="hm-v">{{hero.humidity}}</text>
        <text class="hm-u">%</text>
      </view>
      <view class="hero-metric">
        <text class="hm-k">异常持续</text>
        <text class="hm-v hm-duration">{{hero.duration}}</text>
      </view>
    </view>

    <view class="hero-reason">{{hero.reason}}</view>

    <view class="hero-actions">
      <button class="fan-btn" size="mini" disabled="{{!hero.canFan}}"
              bindtap="onFan" data-node="{{hero.id}}">开启风扇</button>
      <button class="focus-btn {{hero.isFocus ? 'focused' : ''}}" size="mini"
              data-node="{{hero.id}}" bindtap="onSetFocus">
        {{hero.isFocus ? '★ 已设为重点' : '设为重点'}}
      </button>
    </view>
  </view>

  <!-- 三个宿舍（数据按 nodeId 隔离） -->
  <view class="section-title">三个宿舍</view>
  <view class="cards">
    <view class="card" wx:for="{{nodes}}" wx:key="id">
      <view class="card-head">
        <view>
          <text class="name">{{item.label}}</text>
          <text class="node-id">{{item.id}}</text>
        </view>
        <button class="focus-btn {{item.isFocus ? 'focused' : ''}}" size="mini"
                data-node="{{item.id}}" bindtap="onSetFocus">
          {{item.isFocus ? '★ 重点' : '设为重点'}}
        </button>
      </view>

      <view class="metrics">
        <view class="metric">
          <text class="k">温度</text>
          <text class="v">{{item.temperature}}</text>
          <text class="u">℃</text>
        </view>
        <view class="metric">
          <text class="k">湿度</text>
          <text class="v">{{item.humidity}}</text>
          <text class="u">%</text>
        </view>
      </view>

      <view class="tags">
        <text class="tag {{item.statusClass}}">{{item.status}}</text>
        <text class="tag {{item.phaseClass}}">{{item.phaseLabel}}</text>
        <text class="tag tag-offline" wx:if="{{item.offline}}">节点离线</text>
      </view>

      <view class="episode" wx:if="{{item.episodeText}}">{{item.episodeText}}</view>

      <button class="fan-btn" size="mini" disabled="{{!item.canFan}}"
              bindtap="onFan" data-node="{{item.id}}">开启风扇</button>
    </view>
  </view>

  <!-- 本地历史记录（事件闭环归档） -->
  <view class="recent" wx:if="{{recentEvents.length}}">
    <view class="section-title">最近事件（本地历史记录）</view>
    <view class="recent-item" wx:for="{{recentEvents}}" wx:key="event_id">
      <text class="r-id">{{item.event_id}}</text>
      <text class="r-info">{{item.nodeId}} · {{item.type}} · {{item.status}}</text>
    </view>
  </view>

  <!-- M4 手动分析（保留） -->
  <view class="collapse">
    <view class="collapse-head" bindtap="toggleManual">
      <text>手动环境分析（M4）</text>
      <text class="collapse-toggle">{{manualOpen ? '收起 ▲' : '展开 ▼'}}</text>
    </view>

    <view class="collapse-body" wx:if="{{manualOpen}}">
      <view class="input-group">
        <text class="label">温度 (℃)</text>
        <input type="number" bindinput="onTempInput" placeholder="请输入温度" value="{{temperature}}" />
      </view>
      <view class="input-group">
        <text class="label">湿度 (%)</text>
        <input type="number" bindinput="onHumidInput" placeholder="请输入湿度" value="{{humidity}}" />
      </view>

      <button class="btn" bindtap="analyzeEnvironment">分析环境</button>

      <view class="result-box">
        <view>当前状态：{{manualStatus}}</view>
        <view>建议：{{manualAdvice}}</view>
      </view>
    </view>
  </view>

</view>
