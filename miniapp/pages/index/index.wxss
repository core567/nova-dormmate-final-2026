/**index.wxss —— 任务 D 实时看板样式**/
page {
  background: #f1f5f9;
}

.page {
  padding: 20rpx 24rpx 60rpx;
}

/* ---- 连接状态 ---- */
.conn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
}
.conn-ok { color: #15803d; background: #dcfce7; }
.conn-bad { color: #b91c1c; background: #fee2e2; }

/* ---- 品牌 ---- */
.brand {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.brand-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #0f172a;
  letter-spacing: 1rpx;
}
.brand-sub {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #06b6d4;
  font-weight: bold;
}

/* ---- 当前重点宿舍 / 优先关注 ---- */
.hero {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-left: 10rpx solid #94a3b8;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, .06);
}
/* 存在异常时整个 hero 转为警戒色，一眼可见 */
.hero-alert { border-left-color: #dc2626; background: #fff7f7; }

.hero-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6rpx;
}
.hero-label { font-size: 24rpx; color: #64748b; font-weight: bold; }
.hero-node-id { font-size: 22rpx; color: #94a3b8; }
.hero-name {
  font-size: 38rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 14rpx;
}
.hero-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 18rpx; }

.hero-metrics {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.hero-metric { display: flex; align-items: baseline; gap: 4rpx; flex: 1; }
.hero-metric .hm-k {
  font-size: 22rpx;
  color: #64748b;
  margin-right: 4rpx;
}
.hero-metric .hm-v {
  font-size: 40rpx;
  font-weight: bold;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}
.hero-metric .hm-duration { font-size: 30rpx; color: #b45309; }
.hero-metric .hm-u { font-size: 22rpx; color: #64748b; }

.hero-reason {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
  margin-bottom: 18rpx;
}
.hero-actions { display: flex; gap: 16rpx; }
.hero-actions button { margin: 0; }

/* ---- 宿舍卡片 ---- */
.card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

/* 任务 E3：设为重点宿舍（会广播给 Web 与 3D） */
.focus-btn {
  margin: 0;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
  line-height: 1.8;
  background: #f1f5f9;
  color: #475569;
  border-radius: 999rpx;
}
.focus-btn.focused {
  background: #2563eb;
  color: #ffffff;
  font-weight: bold;
}
.name { font-size: 30rpx; font-weight: bold; color: #1e293b; }
.node-id { font-size: 22rpx; color: #94a3b8; }

.metrics {
  display: flex;
  gap: 40rpx;
  margin-bottom: 14rpx;
}
.metric { display: flex; align-items: baseline; }
.metric .k { font-size: 24rpx; color: #94a3b8; margin-right: 8rpx; }
.metric .v { font-size: 38rpx; font-weight: bold; color: #1e293b; }
.metric .u { font-size: 22rpx; color: #94a3b8; margin-left: 4rpx; }

.tags { display: flex; gap: 12rpx; }
.tag {
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: bold;
  color: #ffffff;
  background: #94a3b8;
}
.st-normal { background: #16a34a; }
.st-hot    { background: #dc2626; }
.st-wet    { background: #2563eb; }
.st-cold   { background: #f59e0b; }

.ph-normal    { background: #94a3b8; }
.ph-open      { background: #f59e0b; }
.ph-handling  { background: #2563eb; }
.ph-recovered { background: #16a34a; }

/* 任务 D4：节点离线徽标 */
.tag-offline  { background: #475569; }

.episode {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.fan-btn {
  margin-top: 18rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 10rpx;
}
.fan-btn[disabled] {
  background: #cbd5e1 !important;
  color: #ffffff !important;
}

/* ---- 最近事件 ---- */
.recent {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}
.recent-item {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid #f1f5f9;
}
.r-id { color: #2563eb; font-weight: bold; }
.r-info { color: #475569; }

/* ---- M4 手动分析折叠区 ---- */
.collapse {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
}
.collapse-head {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #475569;
}
.collapse-toggle { font-size: 24rpx; color: #94a3b8; font-weight: normal; }
.collapse-body {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid #f1f5f9;
}

.input-group {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
}
.input-group .label {
  width: 160rpx;
  font-size: 26rpx;
  color: #64748b;
}
.input-group input {
  flex: 1;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

.btn {
  margin-top: 10rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 10rpx;
}

.result-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: #f8fafc;
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.8;
}
